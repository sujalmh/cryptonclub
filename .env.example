# Copy this file to .env and fill in your own values. Never commit .env to git.
# Frontend dev server proxies /api -> http://localhost:3001 (see vite.config.ts)

# MongoDB Atlas connection string (used by server/server.js and api/index.js)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: backend port (defaults to 3001)
PORT=3001
